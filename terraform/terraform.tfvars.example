# Copy this file to terraform.tfvars and fill in values specific to your
# subscription. terraform.tfvars should NOT be committed to version control.
#
# db_admin_username and db_admin_password are intentionally left out of this
# file. Supply them via TF_VAR_db_admin_username / TF_VAR_db_admin_password
# environment variables, or as secret pipeline variables in Azure DevOps.
# Never put credentials in a .tfvars file that gets committed.

location            = "eastus"
resource_group_name = "epicbook-rg"
project_name        = "epicbook"

vnet_cidr             = "10.20.0.0/16"
frontend_subnet_cidr  = "10.20.1.0/24"
backend_subnet_cidr   = "10.20.2.0/24"
db_subnet_cidr        = "10.20.3.0/24"

vm_size             = "Standard_B1s"
vm_admin_username   = "azureuser"
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# Restrict SSH access to your own IP and, if applicable, your CI/CD agent's IP.
allowed_admin_ip  = "203.0.113.10/32"
pipeline_agent_ip = ""

backend_app_port = 8080

# Must be globally unique across Azure.
mysql_server_name = "epicbook-mysql-changeme"
mysql_sku_name    = "B_Standard_B1ms"
db_name           = "epicbook"
